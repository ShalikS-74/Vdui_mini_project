table Threshold

	measure 'Threshold value' = IF(ISFILTERED(Threshold[Threshold]), MIN(Threshold[Threshold]), 0.70)
		formatString: 0%

	column Threshold
		dataType: double
		summarizeBy: none
		sourceColumn: Threshold

	partition Threshold = m
		mode: import
		source =
			let
			    Source = #table({"Threshold"}, {{0.3}, {0.5}, {0.7}, {0.9}}),
			    Typed = Table.TransformColumnTypes(Source, {{"Threshold", type number}})
			in
			    Typed
