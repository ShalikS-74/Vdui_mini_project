table Threshold
    measure 'Threshold value' = SELECTEDVALUE(Threshold[Threshold], 0.70)
        formatString: 0%

    column Threshold
        dataType: double
        summarizeBy: none
        sourceColumn: Threshold

    partition Threshold = m
        mode: import
        source =
            let
                Source = #table(
                    {"Threshold"},
                    {
                        {0.50}, {0.60}, {0.70}, {0.80}
                    }
                )
            in
                Source
