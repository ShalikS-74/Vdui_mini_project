table Threshold
    measure 'Threshold value' = IF(ISFILTERED(Threshold[Threshold]), MIN(Threshold[Threshold]), 0.70)
        formatString: 0%

    column Threshold
        dataType: double
        summarizeBy: none
        sourceColumn: Threshold

    partition Threshold = m
        mode: import
        source =
            let
                Source = #table(
                    {"Threshold"},
                    {
                        {0.30}, {0.35}, {0.40}, {0.45}, {0.50},
                        {0.55}, {0.60}, {0.65}, {0.70}, {0.75},
                        {0.80}, {0.85}, {0.90}
                    }
                )
            in
                Source
