table Cases

	column polity
		dataType: string
		summarizeBy: none
		sourceColumn: polity

	column century
		dataType: int64
		summarizeBy: none
		sourceColumn: century

	column oof_p_decline
		dataType: double
		summarizeBy: none
		sourceColumn: oof_p_decline

	column true_label
		dataType: string
		summarizeBy: none
		sourceColumn: true_label

	column fp_flag
		dataType: int64
		summarizeBy: none
		sourceColumn: fp_flag

	column type
		dataType: string
		summarizeBy: none
		sourceColumn: type

	column note
		dataType: string
		summarizeBy: none
		sourceColumn: note

	column source_url
		dataType: double
		summarizeBy: none
		sourceColumn: source_url

	column observation_id
		dataType: string
		summarizeBy: none
		sourceColumn: observation_id

	partition Cases = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents(DataRoot & "\fp_cases.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
			    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
			    Typed = Table.TransformColumnTypes(Headers, {{"polity", type text}, {"century", Int64.Type}, {"oof_p_decline", type number}, {"true_label", type text}, {"fp_flag", Int64.Type}, {"type", type text}, {"note", type text}, {"source_url", type number}}),
			    Keyed = Table.AddColumn(Typed, "observation_id", each [polity] & "|" & Text.From([century]), type text)
			in
			    Keyed
