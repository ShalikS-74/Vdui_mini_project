	partition Cases = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataRoot & "\fp_cases.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"polity", type text}, {"century", Int64.Type}, {"oof_p_decline", type number}, {"true_label", type text}, {"fp_flag", Int64.Type}, {"type", type text}, {"note", type text}, {"source_url", type number}}),
				    Keyed = Table.AddColumn(Typed, "observation_id", each [polity] & "|" & Text.From([century]), type text)
				in
				    Keyed

